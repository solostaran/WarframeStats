{
  "name": "warframestats",
  "version": "1.11.8",
  "private": true,
  "license": "MIT",
  "imports": {
    "#root/*": "./*"
  },
  "scripts": {
    "start": "node ./bin/www",
    "inbd": "npm run install-and-build-docker",
    "install-and-build-docker": "npm install --save-dev cross-env && npm run docker:build",
    "docker:build": "docker build -t app-warstats .",
    "dev": "cross-env NODE_ENV=development DEBUG=warframestats:* DOCKER=false HTTP=true node ./bin/www",
    "prod": "cross-env NODE_ENV=production DEBUG=warframestats:* DOCKER=false HTTP=true node ./bin/www",
    "docker:rundev": "docker run -p 3000:3000 -e NODE_ENV=development -e DOCKER=false -e DEBUG=warframestats:* -e HTTP=true --name app-warstats --rm app-warstats",
    "docker:stop": "docker stop app-warstats",
    "test": "jest",
    "test:integration": "jest tests/integration",
    "test:unit": "jest tests/unit",
    "test:performance": "jest tests/performance",
    "seed:rewards": "node tests/fixtures/seedRewards.js",
    "perf:rewards": "node tests/fixtures/perfRewards.js"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "body-parser": "^2.3.0",
    "cookie-parser": "^1.4.7",
    "debug": "^4.4.3",
    "express": "^5.2.1",
    "express-jwt": "^8.5.1",
    "http-errors": "^2.0.1",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "mongoose": "^8.24.4",
    "morgan": "^1.12.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pug": "^3.0.4"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "playwright": "^1.63.0",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "globalSetup": "<rootDir>/tests/globalSetup.js",
    "globalTeardown": "<rootDir>/tests/globalTeardown.js",
    "collectCoverage": true,
    "coverageDirectory": "<rootDir>/coverage",
    "collectCoverageFrom": [
      "app.js",
      "api/**/*.js",
      "database/**/*.js",
      "security/**/*.js",
      "web/**/*.js"
    ],
    "watchPathIgnorePatterns": [
      "<rootDir>/resources/",
      "<rootDir>/coverage/"
    ]
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.0"
    }
  }
}
